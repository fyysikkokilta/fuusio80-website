# =============================================================================
# FUUSIO ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database_name
DATABASE_URI=postgres://postgres:<password>@127.0.0.1:5432/your-database-name

# =============================================================================
# PAYLOAD CMS CONFIGURATION
# =============================================================================
# Secret key for authentication and encryption (generate a strong random string)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public server URL (used for links, previews, admin panel access)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# =============================================================================
# ILMOMASIINA
# =============================================================================
# Event blocks read events from this Ilmomasiina instance (public API, no key needed)
ILMO_URL=https://ilmo.fyysikkokilta.fi

# Search Console verification (optional)
GOOGLE_SITE_VERIFICATION=

# =============================================================================
# GOOGLE OAUTH (admin login)
# =============================================================================
# The admin panel is logged in to with Google only.
# Redirect URI to allow in Google Cloud: <NEXT_PUBLIC_SERVER_URL>/api/users/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Let any Google account that logs in become a user (true/false).
# Set to true only while creating the first user, then back to false.
# NOTE: In Google Cloud Console the OAuth consent screen is set to "Internal", so only
# accounts from the organisation can even attempt to log in.
# If this is true, EVERY such account is granted access (full admin rights) on first login.
# If false, only users that already exist in the database can log in.
ALLOW_NON_EXISTING_USERS=false
